# Telegram bot that delivers lead-form submissions from the site.
# Create a bot via @BotFather, then message it once (or add it to a group)
# and use https://api.telegram.org/bot<token>/getUpdates to read the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Analytics (GA4) measurement id — https://analytics.google.com
# Leave empty to disable analytics (e.g. in local development).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Yandex Metrika counter id — https://metrika.yandex.ru
# Leave empty to disable analytics (e.g. in local development).
NEXT_PUBLIC_YANDEX_METRIKA_ID=
