# Reverse proxy for tetsub.ru -> the Node process from ecosystem.config.js
# (listening on 127.0.0.1:3000). Copy to /etc/nginx/sites-available/tetsub.ru
# on the Beget VPS, symlink into sites-enabled, then run:
#   certbot --nginx -d tetsub.ru -d www.tetsub.ru
# Certbot rewrites this file to add the SSL server block automatically —
# the config below is the starting point before that.

server {
    listen 80;
    listen [::]:80;
    server_name tetsub.ru www.tetsub.ru;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
